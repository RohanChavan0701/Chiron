+#!/usr/bin/env bash
+# setup_vllm_serve.sh - Build .venv-vllm-serve for scripts/run_load_sweep.sh.
+#
+# The committed matrix used vLLM 0.4.2, whose benchmark_serving.py had only
+# --request-rate (checked in the v0.4.2 source): no fixed-concurrency cap, and
+# no `vllm bench serve` subcommand. The sweep therefore uses a current vLLM in
+# its own venv, pinned here, and is reported as a separate measurement from
+# the 0.4.2 batch-1 row. Record the installed version from the pip freeze the
+# sweep writes; do not mix the two in one table.
+#
+# Usage (from the repo root): scripts/setup_vllm_serve.sh
+set -euo pipefail
+VLLM_VERSION="${VLLM_VERSION:-0.34.0}"   # latest stable on PyPI when this was written (2026-11-27)
+VENV=.venv-vllm-serve
+PYTHON="${PYTHON:-python3}"
+[ -f benchmarks/profiler.py ] || { echo "run from the repo root" >&2; exit 1; }
+if [ ! -x "$VENV/bin/python" ]; then "$PYTHON" -m venv "$VENV"; fi
+"$VENV/bin/python" -m pip install -q --upgrade pip wheel
+"$VENV/bin/pip" install -q "vllm==$VLLM_VERSION" pyyaml
+"$VENV/bin/python" -c "import torch, vllm; assert torch.cuda.is_available(), 'no GPU'; print('vllm', vllm.__version__, 'torch', torch.__version__, torch.cuda.get_device_name(0))"
+"$VENV/bin/vllm" bench serve --help >/dev/null
+echo "ok: $VENV ready (vllm $VLLM_VERSION)"
