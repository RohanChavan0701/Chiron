+"""
+load_sweep_table.py - Markdown table for the concurrent-serving sweep.
+
+Reads the `vllm bench serve` result files written by scripts/run_load_sweep.sh
+(vllm_serve_<variant>_c<N>_run<r>.json) and prints, per variant and
+concurrency level, mean ± std across repeats of request throughput, output
+token throughput, and median / p99 TTFT, TPOT and end-to-end latency. A run
+with failed requests, or with fewer completed requests than prompts, is listed
+under "incomplete runs" and left out of the means rather than dropped silently.
+
+Usage:
+    python analysis/load_sweep_table.py --results-dir results/load_sweep
+"""
+
+import argparse
+import glob
+import json
+import os
+import re
+import sys
+
+import pandas as pd
+
+FILENAME = re.compile(r"vllm_serve_(?P<variant>[a-z_]+)_c(?P<concurrency>\d+)_run(?P<repeat>\d+)\.json$")
+
+COLUMNS = [
+    ("request_throughput", "Requests/s", "{:.2f}"),
+    ("output_throughput", "Output tok/s", "{:.0f}"),
+    ("median_ttft_ms", "TTFT p50 (ms)", "{:.0f}"),
+    ("p99_ttft_ms", "TTFT p99 (ms)", "{:.0f}"),
+    ("median_tpot_ms", "TPOT p50 (ms)", "{:.1f}"),
+    ("p99_tpot_ms", "TPOT p99 (ms)", "{:.1f}"),
+    ("median_e2el_ms", "E2E p50 (ms)", "{:.0f}"),
+    ("p99_e2el_ms", "E2E p99 (ms)", "{:.0f}"),
+]
+
+
+def load_runs(results_dir):
+    rows, incomplete = [], []
+    for path in sorted(glob.glob(os.path.join(results_dir, "vllm_serve_*.json"))):
+        m = FILENAME.search(os.path.basename(path))
+        if not m:
+            continue
+        with open(path) as f:
+            d = json.load(f)
+        row = {
+            "variant": m["variant"],
+            "concurrency": int(m["concurrency"]),
+            "repeat": int(m["repeat"]),
+            "file": os.path.basename(path),
+            "num_prompts": d.get("num_prompts"),
+            "completed": d.get("completed"),
+            "failed": d.get("failed", 0),
+            "max_concurrency": d.get("max_concurrency"),
+        }
+        for key, _, _ in COLUMNS:
+            row[key] = d.get(key)
+        if row["max_concurrency"] not in (None, row["concurrency"]):
+            incomplete.append((row["file"], f"max_concurrency {row['max_concurrency']} != filename {row['concurrency']}"))
+            continue
+        if row["failed"] or (row["num_prompts"] is not None and row["completed"] != row["num_prompts"]):
+            incomplete.append((row["file"], f"completed {row['completed']} of {row['num_prompts']}, failed {row['failed']}"))
+            continue
+        missing = [k for k, _, _ in COLUMNS if row[k] is None]
+        if missing:
+            incomplete.append((row["file"], f"missing {', '.join(missing)}"))
+            continue
+        rows.append(row)
+    return pd.DataFrame(rows), incomplete
+
+
+def fmt(mean, std, pattern):
+    if pd.isna(std):
+        return pattern.format(mean)
+    return f"{pattern.format(mean)} ± {pattern.format(std)}"
+
+
+def table(df):
+    lines = []
+    header = "| Variant | Concurrency | Runs | " + " | ".join(label for _, label, _ in COLUMNS) + " |"
+    lines.append(header)
+    lines.append("|" + "---|" * (3 + len(COLUMNS)))
+    grouped = df.groupby(["variant", "concurrency"], sort=True)
+    for (variant, c), g in grouped:
+        cells = [variant, str(c), str(len(g))]
+        for key, _, pattern in COLUMNS:
+            cells.append(fmt(g[key].mean(), g[key].std(ddof=1) if len(g) > 1 else float("nan"), pattern))
+        lines.append("| " + " | ".join(cells) + " |")
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Print the load-sweep table")
+    parser.add_argument("--results-dir", default="results/load_sweep")
+    args = parser.parse_args()
+
+    df, incomplete = load_runs(args.results_dir)
+    if df.empty and not incomplete:
+        print(f"No vllm_serve_*.json files in {args.results_dir}")
+        return 1
+    if not df.empty:
+        print(table(df))
+        print()
+        print("Values are mean ± std across repeats. TTFT: time to first token; TPOT: time per output token after the first; E2E: full request.")
+    if incomplete:
+        print()
+        print("Incomplete runs (left out of the means):")
+        for name, why in incomplete:
+            print(f"- `{name}`: {why}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
