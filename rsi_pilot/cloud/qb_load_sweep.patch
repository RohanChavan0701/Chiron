+++ b/scripts/run_load_sweep.sh
@@ -0,0 +1,167 @@
+#!/usr/bin/env bash
+# run_load_sweep.sh - Concurrent-serving sweep for vLLM (the workload the
+# committed batch-size-1 matrix never measured).
+#
+# Starts `vllm serve` once, then runs vLLM's own serving benchmark
+# (`vllm bench serve`) at each concurrency level, REPEATS times, with the
+# documented "maximum throughput" load pattern: --request-rate inf (all
+# requests queued at t=0) and --max-concurrency N (a gateway-style cap on
+# in-flight requests). Two variants per level:
+#
+#   fixed_prompt  the matrix's single prompt from the config, repeated, with
+#                 exactly OUTPUT_LEN output tokens (--ignore-eos), so the
+#                 concurrency-1 cell is comparable with the committed vllm/fp16 row
+#                 when run on the same GPU type, apart from the vLLM version and the
+#                 client path.
+#   random        random prompts, input 256 +-50%, output OUTPUT_LEN +-50%.
+#                 With identical requests and a concurrency cap, requests run
+#                 in synchronized waves and each TTFT includes the whole wave's
+#                 prefill (vLLM docs, "Load Pattern Configuration"); the random
+#                 variant staggers the work so the wave artefact is visible by
+#                 comparison instead of hidden.
+#
+# Needs: scripts/setup_vllm_serve.sh run first (.venv-vllm-serve), HF_TOKEN
+# for the gated model, one free GPU.
+#
+# Usage (from the repo root):
+#   scripts/run_load_sweep.sh --out results/load_sweep --repeats 3
+#   scripts/run_load_sweep.sh --out results/load_sweep_smoke --repeats 1 \
+#       --concurrency "1 4" --num-prompts 8
+#
+# Writes into --out: vllm_serve_<variant>_c<N>_run<r>.json (vLLM's result
+# format, with per-request detail), server.log, ENVIRONMENT_serve.md,
+# freeze-venv-vllm-serve.txt, logs/<step>.log, timings.tsv, FAILURES.txt.
+
+set -uo pipefail
+
+OUT="" REPEATS=3 CONCURRENCY="1 4 16 64" NUM_PROMPTS=128 OUTPUT_LEN=128
+CONFIG="configs/final.yaml" PORT=8011 VENV=".venv-vllm-serve"
+MAX_MODEL_LEN=4096      # same as benchmarks/run_vllm.py
+WARMUPS=4
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --out) OUT=$2; shift 2 ;;
+    --repeats) REPEATS=$2; shift 2 ;;
+    --concurrency) CONCURRENCY=$2; shift 2 ;;
+    --num-prompts) NUM_PROMPTS=$2; shift 2 ;;
+    --output-len) OUTPUT_LEN=$2; shift 2 ;;
+    --config) CONFIG=$2; shift 2 ;;
+    --port) PORT=$2; shift 2 ;;
+    *) echo "unknown option: $1" >&2; exit 2 ;;
+  esac
+done
+[ -n "$OUT" ] || { echo "need --out" >&2; exit 2; }
+[ -x "$VENV/bin/vllm" ] || { echo "no $VENV/bin/vllm; run scripts/setup_vllm_serve.sh" >&2; exit 2; }
+[ -f "$CONFIG" ] || { echo "no config $CONFIG" >&2; exit 2; }
+
+mkdir -p "$OUT/logs"
+TIMINGS="$OUT/timings.tsv"; FAILURES="$OUT/FAILURES.txt"
+[ -f "$TIMINGS" ] || printf 'step\tseconds\texit_code\n' > "$TIMINGS"
+
+PY="$VENV/bin/python"
+MODEL=$("$PY" -c "import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))['model']['name'])" "$CONFIG")
+REVISION=$("$PY" -c "import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))['model'].get('revision','main'))" "$CONFIG")
+SERVED=mistral-7b
+
+# The fixed prompt, repeated NUM_PROMPTS times, in the custom-dataset format
+# (one {"prompt": ...} per line; vLLM docs, "Custom Dataset").
+DATA="$OUT/fixed_prompt.jsonl"
+"$PY" - "$CONFIG" "$NUM_PROMPTS" > "$DATA" <<'PYEOF'
+import json, sys, yaml
+cfg = yaml.safe_load(open(sys.argv[1]))
+prompt = cfg["profiling"]["prompt"].strip()
+for _ in range(int(sys.argv[2])):
+    print(json.dumps({"prompt": prompt}))
+PYEOF
+
+# ---------------------------------------------------------------------------
+# Environment record and server
+# ---------------------------------------------------------------------------
+{
+  echo "# Serving environment"
+  echo
+  echo "Recorded by \`scripts/run_load_sweep.sh\` on $(date -u +%Y-%m-%dT%H:%M:%SZ)."
+  echo
+  echo "- Repo commit: $(git rev-parse HEAD)"
+  echo "- Model: \`$MODEL\` @ \`$REVISION\`"
+  echo "- vllm: $("$VENV/bin/vllm" --version 2>/dev/null | tail -1)"
+  echo "- torch: $("$PY" -c 'import torch; print(torch.__version__)')"
+  echo "- Python: $("$PY" --version)"
+  echo "- Server args: --dtype float16 --max-model-len $MAX_MODEL_LEN"
+  echo "- Client: vllm bench serve, --request-rate inf, --max-concurrency {$CONCURRENCY}, --num-prompts $NUM_PROMPTS, output $OUTPUT_LEN tokens (--ignore-eos), $WARMUPS warmups, $REPEATS repeats"
+  echo
+  echo '```'
+  nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
+  echo '```'
+} > "$OUT/ENVIRONMENT_serve.md"
+"$VENV/bin/pip" freeze > "$OUT/freeze-venv-vllm-serve.txt"
+
+echo "Starting vllm serve $MODEL on port $PORT"
+"$VENV/bin/vllm" serve "$MODEL" --revision "$REVISION" --tokenizer-revision "$REVISION" \
+  --dtype float16 --max-model-len "$MAX_MODEL_LEN" --port "$PORT" \
+  --served-model-name "$SERVED" > "$OUT/server.log" 2>&1 &
+SERVER_PID=$!
+cleanup() { kill "$SERVER_PID" 2>/dev/null; wait "$SERVER_PID" 2>/dev/null; }
+trap cleanup EXIT
+
+waited=0
+until curl -sf "http://127.0.0.1:$PORT/health" >/dev/null; do
+  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
+    echo "server exited during startup; see $OUT/server.log" >&2; exit 1
+  fi
+  if [ "$waited" -ge 1200 ]; then echo "server not healthy after 20 min" >&2; exit 1; fi
+  sleep 5; waited=$((waited + 5))
+done
+echo "Server healthy after ${waited}s"
+nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1 > "$OUT/server_gpu_memory_mb.txt"
+
+run_step() {
+  local name=$1; shift
+  echo "--> $name"
+  local start=$SECONDS
+  "$@" > "$OUT/logs/$name.log" 2>&1
+  local rc=$?
+  local secs=$((SECONDS - start))
+  printf '%s\t%s\t%s\n' "$name" "$secs" "$rc" >> "$TIMINGS"
+  if [ "$rc" -ne 0 ]; then
+    echo "$name: exit $rc (see logs/$name.log)" >> "$FAILURES"; echo "    FAILED in ${secs}s, exit $rc"
+  else
+    echo "    ok in ${secs}s"
+  fi
+}
+
+# The client tokenizer is loaded at the Hub default revision: `vllm bench serve` has no
+# --tokenizer-revision flag (checked against the argument list, 2026-11-27). The tokenizer
+# files of mistralai/Mistral-7B-v0.1 are the same at the pinned revision; the server itself
+# runs the pinned revision.
+COMMON=(--backend openai --base-url "http://127.0.0.1:$PORT" --endpoint /v1/completions
+        --model "$SERVED" --tokenizer "$MODEL"
+        --request-rate inf --num-prompts "$NUM_PROMPTS" --num-warmups "$WARMUPS"
+        --ignore-eos --temperature 0
+        --percentile-metrics ttft,tpot,itl,e2el,client_queue_time --metric-percentiles 50,99
+        --save-result --save-detailed --result-dir "$OUT")
+
+for c in $CONCURRENCY; do
+  for r in $(seq 1 "$REPEATS"); do
+    run_step "serve_fixed_prompt_c${c}_run${r}" "$VENV/bin/vllm" bench serve "${COMMON[@]}" \
+      --dataset-name custom --dataset-path "$DATA" --skip-chat-template \
+      --custom-output-len "$OUTPUT_LEN" --max-concurrency "$c" --seed "$r" \
+      --result-filename "vllm_serve_fixed_prompt_c${c}_run${r}.json" \
+      --metadata "variant=fixed_prompt" "concurrency=$c" "repeat=$r"
+  done
+done
+
+for c in $CONCURRENCY; do
+  for r in $(seq 1 "$REPEATS"); do
+    run_step "serve_random_c${c}_run${r}" "$VENV/bin/vllm" bench serve "${COMMON[@]}" \
+      --dataset-name random --random-input-len 256 --random-output-len "$OUTPUT_LEN" \
+      --random-range-ratio 0.5 --max-concurrency "$c" --seed "$r" \
+      --result-filename "vllm_serve_random_c${c}_run${r}.json" \
+      --metadata "variant=random" "concurrency=$c" "repeat=$r"
+  done
+done
+
+echo; echo "Timings: $TIMINGS"
+if [ -s "$FAILURES" ]; then echo "Failures:"; cat "$FAILURES"; exit 1; fi
+echo "No failures."
